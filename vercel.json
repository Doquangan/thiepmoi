{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    { "source": "/admin-server", "destination": "/admin.html" },
    { "source": "/assets/(.*)", "destination": "/assets/$1" },
    { "source": "/event-config.json", "destination": "/event-config.json" },
    { "source": "/((?!api|admin-server|assets|favicon\\.ico|_vercel|.*\\..*).+)", "destination": "/index.html" }
  ]
}
